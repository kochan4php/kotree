# Every value is optional. The site runs without Mongo, AI keys or webhooks.
# Copy to .env.local for local development; never commit real secrets.

# MongoDB (fails fast and falls back to an in-memory limiter if absent)
MONGODB_URL=mongodb://localhost:27017

# Public origin used for canonical URLs, feeds and OG metadata
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin sign-in (use long random values in production)
ADMIN_TOKEN=
ADMIN_TOTP_SECRET=
ADMIN_TOTP_RECOVERY=
LOGIN_ALERT_THRESHOLD=5

# Optional incident alerts (absolute HTTPS URLs)
DISCORD_WEBHOOK_URL=
TELEGRAM_WEBHOOK_URL=

# Optional AI terminal quota/key
GEMINI_API_KEY=
CHAT_DISABLED=
