{
  "name": "Kotree | Deo Subarno",
  "short_name": "Kotree",
  "description": "Check out all my social media links in one place. Let’s connect and share inspiration!",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "lang": "en",
  "dir": "ltr",
  "background_color": "#fff7e9",
  "theme_color": "#fff7e9",
  "categories": ["social", "entertainment", "utilities"],
  "shortcuts": [
    {
      "name": "Changelog",
      "url": "/changelog",
      "description": "All notable changes to Kotree"
    },
    {
      "name": "Guestbook",
      "url": "/guestbook",
      "description": "Read and leave obfuscated secrets"
    },
    {
      "name": "Stats",
      "url": "/#stats",
      "description": "Click stats and secrets found"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/home-wide.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Kotree home page on desktop"
    },
    {
      "src": "screenshots/home-narrow.jpg",
      "sizes": "540x720",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Kotree home page on mobile"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    { "src": "icons/icon-48x48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-72x72.png", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-96x96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-128x128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-144x144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-152x152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-256x256.png", "sizes": "256x256", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-384x384.png", "sizes": "384x384", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
