{
  "name": "kotree",
  "version": "3.5.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "prebuild": "node scripts/gen-og.mjs && node scripts/gen-search-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test:unit": "node --experimental-strip-types --test-force-exit --import ./tests/unit/alias-hook.mjs --test \"tests/unit/*.test.ts\"",
    "test:coverage": "node --test-coverage-lines=70 --test-coverage-branches=80 --test-coverage-functions=60 --experimental-strip-types --experimental-test-coverage --test-force-exit --import ./tests/unit/alias-hook.mjs --test \"tests/unit/*.test.ts\"",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "gen:splash": "node scripts/gen-splash.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "supply-chain": "pnpm sbom --sbom-format cyclonedx --prod --lockfile-only --out sbom.cdx.json",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "smoke": "node scripts/smoke.mjs",
    "load:check": "node scripts/load-check.mjs",
    "new:note": "node scripts/new-note.mjs",
    "backup": "node scripts/backup-data.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.61.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-qr-code": "2.2.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/edge-functions": "4.0.3",
    "@netlify/plugin-nextjs": "5.16.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
